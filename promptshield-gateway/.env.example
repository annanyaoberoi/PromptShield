# PromptShield — environment variables
# Copy this file to .env and fill in real values.
# .env is git-ignored; this file is tracked as the template.

# ── Required ──────────────────────────────────────────────────────────────

# The API key clients must supply in every POST /v1/chat request.
# Generate a strong random value: python -c "import secrets; print(secrets.token_urlsafe(32))"
ALLOWED_API_KEY=change-me-before-running

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://promptshield:changeme@localhost:5432/promptshield

# ── Optional (defaults shown) ─────────────────────────────────────────────

# URL of the ShopBot victim service (Phase 0 target).
SHOPBOT_URL=http://localhost:8000/chat

# Port PromptShield listens on.
GATEWAY_PORT=9000

# Seconds before an upstream ShopBot call times out.
HTTP_TIMEOUT_SECONDS=30

# ── Phase 2 additions (uncomment when needed) ─────────────────────────────

# OpenAI-compatible key for the LLM-as-judge layer (Layer 3).
# OPENAI_API_KEY=sk-...

# Confidence threshold below which we escalate to the LLM judge.
# CLASSIFIER_CONFIDENCE_THRESHOLD=0.85
